// Signing for the iPhone app, its widgets and the Apple Watch app. Your Apple developer team goes in Local.xcconfig
// next to this file (not committed):
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// With a free Apple ID (Personal Team), the bundle identifier must also be unique to you; override it there too. The
// widgets, the watch app and the app group they share are named after it:
//
//     APP_BUNDLE_ID = io.github.yourname.MusicLibraryMobile

APP_BUNDLE_ID = io.github.davidlago.MusicLibraryMobile
// The iPhone app and its widgets share this container (the watch app and its complications have their own).
APP_GROUP_IDENTIFIER = group.$(APP_BUNDLE_ID)

// iCloud (docs/icloud-plan.md): the container the Mac app shares. It needs iCloud on the App ID with this container
// assigned (docs/distribution.md), which a Personal Team can't have, so the app is signed without it unless
// Local.xcconfig (or scripts/testflight.sh with ICLOUD=1) switches to the iCloud entitlements:
//
//     APP_ENTITLEMENTS = MusicLibraryMobile.entitlements
ICLOUD_CONTAINER = iCloud.io.github.davidlago.MusicLibrary
APP_ENTITLEMENTS = AppGroup.entitlements

#include "Version.xcconfig"
#include? "Local.xcconfig"
